# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Django
db.sqlite3
db.sqlite3-journal
# WAL sidecars, which appear once journal_mode=WAL is enabled in settings.
db.sqlite3-wal
db.sqlite3-shm
/staticfiles/
media/

# Secrets / local config
.env
.env.*

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code — machine-local permissions (the shared slash commands ARE committed)
.claude/settings.local.json

# Source papers / PDFs used while authoring — not needed at runtime, and often
# third-party material we must not redistribute. Only authored output is committed.
source_papers/
# Real 11+ papers the framework is calibrated against. Same rule as above: they are
# third-party copyright (GL, CEM, ISEB, The Exam Coach), they are large — saved web
# pages drag in a _files/ folder of scripts and images — and nothing at runtime reads
# them. Questions authored from them must be new questions of the same type, never
# transcriptions.
example_papers_maths/
# Same rule again for the NVR side: third-party PDFs (CGP, Bond, Examberry, GL)
# used to audit the NVR module against current 11+ paper standards.
/ NVR example papers\ /
# Per-paper audit reports produced when the taxonomy is calibrated against those
# papers. Kept out of git for the same reason as the papers themselves: they
# quote them, and they are working evidence rather than shipped content. The
# conclusions that survived reconciliation live in taxonomy.json's `evidence`
# fields, which ARE committed — so nothing load-bearing depends on this folder.
paper_audits/

# Office lock files
~$*

# Full database dumps — these contain user emails and password hashes and must
# never be committed.
/backups/
/backup.json
/backup-*.json
*.dump
*.sql

# Catalog snapshot from backup.sh — ignored to keep a large blob from churning on
# every backup run.
# RED FLAG — this is only safe while every question is reproducible from a committed
# contrib_*.json pack. Questions authored via the web app / Django admin live ONLY in
# the database, so the moment that starts happening this snapshot (and DB backups
# generally) become the sole record of that content and must be stored somewhere real.
elevenplus_data/catalog_backup.json

# Working notes carried between sessions, not repository history. See CLAUDE.md.
# Local to each checkout on purpose: they record what is unfixed and unfinished here,
# which is a working state rather than something to merge and resolve conflicts on.
/pending_issues.md
/plans.md

# Output of the figure tools. Both are regenerated on demand and neither is a
# source file: preview_figures.py writes the vocabulary sheet, test_nvr_page.py
# writes the page it rendered so it can be looked at.
/figures-preview.html
/nvr-question.html
